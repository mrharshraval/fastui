# Dependencies & Package Managers
node_modules/
.pnp/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js & Turborepo
.next/
out/
.turbo/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# Python & Virtual Environments
venv/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
*.egg

# Testing & Coverage
coverage/
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.ruff_cache/
.mypy_cache/
test-results/
playwright-report/
playwright/.cache/

# Databases & Local Storage
*.db
*.sqlite
*.sqlite3
fastui_sales.db
data/

# Environment Variables & Secrets
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
services/api/.env
services/api/.env.local
*.pem
*.key
*.cert

# Vercel & Cloud Deployments
.vercel/

# Logs & Temporary Files
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
scratch/
services/api/scratch/
tmp/
temp/

# Operating System & IDEs
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
